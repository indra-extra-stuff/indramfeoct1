# Angular build output (shell and remote microfrontends)
/dist/
/tmp/
/out-tsc/
/bazel-out/

# Dependencies and package-manager caches
node_modules/
.npm/
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Angular and test caches/output
/.angular/cache/
/.sass-cache/
/coverage/
/test-results/
/playwright-report/
/typings/
*.tsbuildinfo

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Keep shared VS Code project settings
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
.vscode-test/

# Miscellaneous
/connect.lock
/libpeerconnection.log
testem.log
*.stackdump

# System files
.DS_Store
Thumbs.db
Desktop.ini
